# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
JWT_SECRET=change-me-to-a-long-random-string

# MongoDB Atlas
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/gaanbajana?retryWrites=true&w=majority

# Admin seed (used by npm run seed)
ADMIN_EMAIL=admin@gaanbajana.com
ADMIN_PASSWORD=ChangeMe123!

# Google OAuth (optional — hides Continue with Google until set)
# Create a Web client at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: {NEXT_PUBLIC_APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cloudinary (https://cloudinary.com) — do now
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email via Resend (https://resend.com) — do now
RESEND_API_KEY=
EMAIL_FROM=Gaanbajana <orders@gaanbajana.com>

# LATER — after site is live (need public website URL for webhooks / return URLs)
# Cashfree Payment Gateway (https://merchant.cashfree.com)
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=sandbox
# Optional: webhook signature secret from Cashfree dashboard
CASHFREE_WEBHOOK_SECRET=

# LATER — after site is live
# Shiprocket (Settings → API → create API user)
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_PICKUP_LOCATION=Primary
