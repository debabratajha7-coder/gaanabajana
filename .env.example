# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
JWT_SECRET=change-me-to-a-long-random-string

# MongoDB Atlas
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/gaanbajana?retryWrites=true&w=majority

# Admin seed (used by npm run seed)
ADMIN_EMAIL=admin@gaanbajana.com
ADMIN_PASSWORD=ChangeMe123!

# Google OAuth (optional — hides Continue with Google until set)
# Create a Web client at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: {NEXT_PUBLIC_APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cloudinary (https://cloudinary.com) — do now
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email via Resend (https://resend.com) — account email OTPs + order mail
RESEND_API_KEY=
EMAIL_FROM=Gaanabajana <info@gaanabajana.com>

# Twilio SMS OTPs (https://console.twilio.com) — phone signup + admin 2FA
# Account SID must start with AC (Console → Account Info)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Preferred: Twilio Verify service SID (starts with VA)
TWILIO_VERIFY_SERVICE_SID=
# Or Programmable SMS sender (if not using Verify)
TWILIO_FROM_NUMBER=
# Optional: seed main admin phone for SMS login OTP
ADMIN_PHONE=

# LATER — after site is live (need public website URL for webhooks / return URLs)
# PhonePe Payment Gateway (https://business.phonepe.com / developer.phonepe.com)
# From Merchant Dashboard → Payment Gateway → API Keys
PHONEPE_CLIENT_ID=
PHONEPE_CLIENT_SECRET=
PHONEPE_CLIENT_VERSION=1
PHONEPE_ENV=sandbox
# Optional: username/password you set for S2S callbacks in PhonePe dashboard
PHONEPE_WEBHOOK_USERNAME=
PHONEPE_WEBHOOK_PASSWORD=

# LATER — after site is live
# Shiprocket (Settings → API → create API user)
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_PICKUP_LOCATION=Primary
# Webhook token you invent — paste same value in Shiprocket → Webhooks → Token
# Callback URL: https://YOUR_DOMAIN/api/webhooks/fulfillment
# (path must not contain “shiprocket” / “sr” / “kr”)
SHIPROCKET_WEBHOOK_TOKEN=
